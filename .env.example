# ---------------------------------------------------------------------------
# Voltiq API - variaveis de ambiente (Fly.io secrets em producao)
# ---------------------------------------------------------------------------
APP_ENV=development                 # production exige DATABASE_URL e JWT_SECRET >= 32 chars
PORT=8080

# Banco (Supabase/PostgreSQL + TimescaleDB). Sem DATABASE_URL usa DATABASE_HOST etc.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voltiq-sw?sslmode=disable

# Autenticacao
JWT_SECRET=troque-por-uma-string-aleatoria-com-32-ou-mais-caracteres
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7
COOKIE_SECURE=false                 # true em producao (HTTPS)
COOKIE_SAMESITE=lax                 # none quando front e API estao em dominios diferentes
COOKIE_DOMAIN=

# Frontend
DASHBOARD_URL=http://localhost:5173 # links de e-mail (convites, alertas, cobranca)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
TRUST_PROXY=false                   # true so atras de proxy que reescreve X-Forwarded-For

# Trial
TRIAL_DAYS=14

# E-mail (Resend) - alertas, convites e cobranca
RESEND_API_KEY=
EMAIL_FROM=alertas@voltiq.com.br
EMAIL_FROM_NAME=Voltiq
EMAIL_REPLY_TO=suporte@voltiq.com.br

# WhatsApp (Z-API) - somente alertas CRITICOS
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Pagamentos (Asaas)
ASAAS_API_KEY=
ASAAS_WEBHOOK_KEY=
ASAAS_SANDBOX=true

# Jobs agendados em processo (trial, cobranca, metricas, webhooks, alertas,
# balanco diario). Use "api cron" para rodar todos uma vez.
SCHEDULER_ENABLED=true
ALERT_WORKERS=2

# Somente desenvolvimento: cria um SUPER_ADMIN no primeiro tenant
SEED_SUPER_ADMIN_EMAIL=super@admin.local
SEED_SUPER_ADMIN_PASSWORD=

# Dados abertos da ANEEL (tarifa de referência do tenant). Opcionais: o
# padrão é o portal oficial e o conjunto "Tarifas de Aplicação".
# ANEEL_OPEN_DATA_URL=https://dadosabertos.aneel.gov.br
# ANEEL_TARIFF_RESOURCE_ID=fcf2906c-7c32-4b9b-a637-054e7a5234f4
